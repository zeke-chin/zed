[
  {
    "context": "Editor && copy_anchor_enabled && copy_anchor_has_selection",
    "bindings": {
      "cmd-c": "copy_anchor::Copy"
    }
  },
  {
    "context": "Editor && copy_anchor_enabled",
    "bindings": {
      "ctrl-\\ ctrl-\\": "copy_anchor::ToggleContextMode"
    }
  },
  {
    "context": "Editor && json_explorer_enabled && json_explorer_convertible",
    "bindings": {
      "cmd-;": "json_explorer::ToggleCurrentDocument"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-w": "window_switcher::Toggle"
    }
  }
]
