[
  {
    "context": "Editor && copy_anchor_enabled && copy_anchor_has_selection",
    "bindings": {
      "cmd-c": "copy_anchor::Copy"
    }
  },
  {
    "context": "Editor && copy_anchor_enabled",
    "bindings": {
      "ctrl-\\ ctrl-\\": "copy_anchor::ToggleContextMode"
    }
  },
  {
    "context": "Editor && json_explorer_enabled && json_explorer_convertible",
    "bindings": {
      "cmd-;": "json_explorer::ToggleCurrentDocument"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-cmd-w": "window_switcher::Toggle"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-f": "fork_search_panel::Deploy"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-shift-f": "fork_search_panel::Deploy"
    }
  },
  {
    "context": "ForkSearchPanel",
    "bindings": {
      "enter": "menu::Confirm",
      "cmd-enter": "fork_search_panel::OpenSelected",
      "up": "menu::SelectPrevious",
      "down": "menu::SelectNext",
      "left": "fork_search_panel::Collapse",
      "right": "fork_search_panel::Expand",
      "escape": "menu::Cancel"
    }
  },
  {
    "context": "Editor && fork_search_input",
    "bindings": {
      "enter": "fork_search_panel::Search",
      "down": "fork_search_panel::FocusResults",
      "cmd-enter": "fork_search_panel::OpenInEditor"
    }
  }
]
